generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Collectivite {
  id        String   @id @default(uuid())
  nom       String
  type      String
  siret     String?
  adresse   String?
  codePostal String?
  ville     String?
  email     String?
  telephone String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  projets   Projet[]
  users     User[]
}

model Projet {
  id              String    @id @default(uuid())
  titre           String
  description     String?
  typeProjet      String?
  montantHt       String?
  montantTtc      String?
  dateDebut       DateTime?
  dateFin         DateTime?
  statut          String    @default("brouillon")
  collectiviteId  String
  collectivite    Collectivite @relation(fields: [collectiviteId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  dossiers        DossierSubvention[]
  notifications   Notification[]
}

model Dispositif {
  id                    String    @id @default(uuid())
  nom                   String
  description           String?
  organisme             String?
  typesProjets          String[]
  tauxMin               String?
  tauxMax               String?
  montantMin            Int?
  montantMax            Int?
  zonesEligibles        String[]
  dateOuverture         DateTime?
  dateCloture           DateTime?
  url                   String?
  criteresEligibilite   String?
  documentsRequis       String[]
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  dossiers              DossierSubvention[]
  notifications         Notification[]
}

model DossierSubvention {
  id                String    @id @default(uuid())
  projetId          String
  dispositifId      String
  projet            Projet    @relation(fields: [projetId], references: [id], onDelete: Cascade)
  dispositif        Dispositif @relation(fields: [dispositifId], references: [id], onDelete: Cascade)

  statut            String    @default("brouillon")
  // Statuts possibles: brouillon, en_cours, depose, accepte, refuse, abandonne

  montantDemande    Float?
  montantAccorde    Float?
  tauxRetenu        Float?

  dateCreation      DateTime  @default(now())
  dateDepot         DateTime?
  dateDecision      DateTime?
  echeanceDepot     DateTime?

  notes             String?
  documentsJoints   String[]  // URLs des documents

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  notifications     Notification[]

  @@unique([projetId, dispositifId])
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  password        String
  nom             String
  prenom          String
  role            String    @default("user")
  // Rôles possibles: admin, manager, user

  collectiviteId  String?
  collectivite    Collectivite? @relation(fields: [collectiviteId], references: [id], onDelete: SetNull)

  lastLogin       DateTime?
  isActive        Boolean   @default(true)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  pdfTemplates    PdfTemplate[]
  notifications   Notification[]
}

model PdfTemplate {
  id              String    @id @default(uuid())
  nom             String
  description     String?

  // Propriétaire du template
  userId          String?
  user            User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  collectiviteId  String?

  // Template par défaut
  isDefault       Boolean   @default(false)
  isPublic        Boolean   @default(false)

  // === CONFIGURATION VISUELLE ===

  // Logo
  logoUrl         String?
  logoPosition    String    @default("header-left") // header-left, header-center, header-right
  logoWidth       Int       @default(150) // en pixels
  logoHeight      Int       @default(50)

  // Polices
  fontFamily      String    @default("Helvetica")
  fontSize        Int       @default(10)
  fontSizeTitle   Int       @default(20)
  fontSizeHeading Int       @default(12)

  // Couleurs (format hex)
  colorPrimary    String    @default("#1e40af") // Bleu principal
  colorSecondary  String    @default("#000000") // Noir texte
  colorAccent     String    @default("#64748b") // Gris

  // Marges (en points PDF)
  marginTop       Int       @default(50)
  marginBottom    Int       @default(50)
  marginLeft      Int       @default(50)
  marginRight     Int       @default(50)

  // En-tête et pied de page
  headerText      String?
  headerAlign     String    @default("center") // left, center, right
  footerText      String    @default("Document généré par Granto.ai")
  footerAlign     String    @default("center")
  showPageNumbers Boolean   @default(false)

  // === CONFIGURATION STRUCTURELLE ===

  // Ordre des sections (JSON array)
  // Exemple: ["collectivite", "contexte", "description", "financement", "calendrier", "pieces", "financeur"]
  sectionsOrder   Json      @default("[\"collectivite\",\"contexte\",\"description\",\"financement\",\"calendrier\",\"pieces\",\"financeur\"]")

  // Sections activées/désactivées
  sectionsEnabled Json      @default("{\"collectivite\":true,\"contexte\":true,\"description\":true,\"financement\":true,\"calendrier\":true,\"pieces\":true,\"financeur\":true}")

  // Configuration par section (JSON)
  // Exemple: {"contexte": {"title": "1. CONTEXTE COMMUNAL", "fontSize": 12}, ...}
  sectionsConfig  Json      @default("{}")

  // === MÉTADONNÉES ===

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lastUsedAt      DateTime?
  usageCount      Int       @default(0)

  @@index([userId])
  @@index([collectiviteId])
  @@index([isDefault])
}

model Notification {
  id              String    @id @default(uuid())

  // Type de notification
  // echeance_proche, echeance_urgente, echeance_depassee, nouveau_dispositif, statut_dossier
  type            String

  // Titre et message
  titre           String
  message         String?

  // Niveau de priorité
  // info, warning, urgent, success
  priorite        String    @default("info")

  // État de lecture
  isRead          Boolean   @default(false)

  // Références optionnelles
  dossierId       String?
  dossier         DossierSubvention? @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  dispositifId    String?
  dispositif      Dispositif? @relation(fields: [dispositifId], references: [id], onDelete: Cascade)

  projetId        String?
  projet          Projet? @relation(fields: [projetId], references: [id], onDelete: Cascade)

  // Utilisateur destinataire (optionnel pour l'instant)
  userId          String?
  user            User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Métadonnées
  createdAt       DateTime  @default(now())
  readAt          DateTime?

  @@index([userId])
  @@index([isRead])
  @@index([type])
  @@index([priorite])
  @@index([createdAt])
}
